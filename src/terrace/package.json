{
  "name": "@schrodinger/terrace",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --config app/vite.config.js",
    "compile": "npm run clean && npm run compile-domain && npm run compile-scripts && npm run compile-app",
    "compile-app": "vite build --config app/vite.config.js",
    "compile-domain": "tsc -p domain/tsconfig.json && tsc-alias -p domain/tsconfig.json",
    "compile-scripts": "tsc -p scripts/tsconfig.json && tsc-alias -p scripts/tsconfig.json",
    "clean": "rimraf ../../build/terrace"
  }
}
