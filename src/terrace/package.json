{
  "name": "@schrodinger/terrace",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --config app/vite.config.js",
    "build": "npm run clean && npm run build-domain && npm run build-scripts && npm run build-app",
    "build-app": "vite build --config app/vite.config.js",
    "build-domain": "tsc -p domain/tsconfig.json && tsc-alias -p domain/tsconfig.json",
    "build-scripts": "tsc -p scripts/tsconfig.json && tsc-alias -p scripts/tsconfig.json",
    "clean": "rimraf ../../build/terrace"
  }
}
