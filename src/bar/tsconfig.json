{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "./",
    "outDir": "../../build/bar",
    "paths": {
      "^/*": ["./*"],
      "@schrodinger/common/*": ["../common/*"]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true
  },
  "references": [
    { "path" : "../common" }
  ],
  "include": ["./domain/**/*"]
}
