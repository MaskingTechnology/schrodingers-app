{
  "name": "Schrödinger's app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "rimraf build dist",
    "build": "npm run build --workspaces",

    "dist": "rimraf dist && jitar build && npm run copy",
    "copy": "npm run copy-apps && npm run copy-assets",
    "copy-apps": "cpx 'build/*/app/**/*' 'dist'",
    "copy-assets": "cpx 'build/*/assets/**/*' 'dist'",
    
    "dev": "jitar start --service=services/development/worker.json",

    "gateway": "jitar start --service=services/production/gateway.json",
    "domain": "jitar start --service=services/production/domain.json",
    "terrace-persistence": "jitar start --service=services/production/terrace-persistence.json",
    "terrace-app": "jitar start --service=services/production/terrace-app.json",
    "terrace-proxy": "jitar start --service=services/production/terrace-proxy.json",
    "bar-persistence": "jitar start --service=services/production/bar-persistence.json",
    "bar-app": "jitar start --service=services/production/bar-app.json",
    "bar-proxy": "jitar start --service=services/production/bar-proxy.json"
  },
  "workspaces": [
    "src/common",
    "src/terrace",
    "src/bar"
  ],
  "dependencies": {
    "jitar": "0.11.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@jitar/plugin-vite": "0.11.2",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "cpx2": "9.0.0",
    "rimraf": "6.1.3",
    "tsc-alias": "1.8.17",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
