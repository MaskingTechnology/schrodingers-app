{
  "name": "Schrödinger's app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "rimraf build",
    "build": "rimraf build && npm run build-domains && npm run build-apps",
    "build-domains": "npm run build-domain --workspaces",
    "build-apps": "npm run build-app --workspaces --if-present",
    "dev": "node ./build/common/infrastructure/bootstrap.js --port=3000 --init=./segments/development/domain.json",
    "terrace-domain": "node ./build/common/infrastructure/bootstrap.js --port=3110 --init=./segments/production/terrace.domain.json",
    "terrace-app": "ws --directory build/terrace/app --spa index.html --port 3100 --rewrite '/terrace/(.*) -> http://localhost:3110/terrace/$1'",
    "bar-domain": "node ./build/common/infrastructure/bootstrap.js --port=3210 --init=./segments/production/bar.domain.json",
    "bar-app": "ws --directory build/bar/app --spa index.html --port 3200 --rewrite '/bar/(.*) -> http://localhost:3210/bar/$1'"
  },
  "workspaces": [
    "src/common",
    "src/terrace",
    "src/bar"
  ],
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "cpx2": "9.0.0",
    "local-web-server": "^5.4.0",
    "rimraf": "6.1.3",
    "ts-add-js-extension": "^1.6.6",
    "tsc-alias": "1.8.17",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
