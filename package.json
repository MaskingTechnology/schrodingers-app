{
  "name": "Schrödinger's app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "rimraf build dist",

    "build": "npm run compile && npm run bundle",

    "compile": "rimraf build && npm run compile-domain && npm run compile-app",
    "compile-domain": "tsc -p src/tsconfig.json && tsc-alias -p src/tsconfig.json",
    "compile-app": "vite build --config src/app/vite.config.js",

    "bundle": "rimraf dist && jitar build && npm run copy",
    "copy": "npm run copy-apps && npm run copy-assets",
    "copy-apps": "cpx 'build/*/app/**/*' 'dist'",
    "copy-assets": "cpx 'build/*/assets/**/*' 'dist'",

    "dev-app": "vite --config src/app/vite.config.js",
    "dev-domain": "jitar start --service=services/worker.json"
  },
  "dependencies": {
    "jitar": "0.11.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@jitar/plugin-vite": "0.11.3",
    "@types/node": "24.13.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "cpx2": "^9.0.3",
    "rimraf": "6.1.3",
    "tsc-alias": "1.9.5",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
