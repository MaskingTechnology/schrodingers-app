{
  "name": "Schrödinger's app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "rimraf build dist",

    "build": "npm run compile && npm run bundle",

    "compile": "rimraf build && npm run compile-domains && npm run compile-apps",
    "compile-domains": "npm run compile-domain --workspaces --if-present",
    "compile-apps": "npm run compile-app --workspaces --if-present",

    "bundle": "rimraf dist && jitar build && npm run copy",
    "copy": "npm run copy-apps && npm run copy-assets",
    "copy-apps": "cpx 'build/*/app/**/*' 'dist'",
    "copy-assets": "cpx 'build/*/assets/**/*' 'dist'",
    
    "dev": "jitar start --service=services/development/worker.json",

    "prod-start": "pm2 start ecosystem.config.cjs",
    "prod-stop": "pm2 stop ecosystem.config.cjs",
    "prod-down": "pm2 delete ecosystem.config.cjs",
    "prod-list": "pm2 list",
    "prod-monitor": "pm2 monit",

    "gateway": "jitar start --service=services/production/gateway.json",
    "domain": "jitar start --service=services/production/domain.json",
    "terrace-app": "jitar start --service=services/production/terrace-app.json",
    "terrace-proxy": "jitar start --service=services/production/terrace-proxy.json",
    "bar-app": "jitar start --service=services/production/bar-app.json",
    "bar-proxy": "jitar start --service=services/production/bar-proxy.json"
  },
  "workspaces": [
    "src/common",
    "src/terrace",
    "src/bar"
  ],
  "dependencies": {
    "jitar": "0.11.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@jitar/plugin-vite": "0.11.3",
    "@types/node": "24.13.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "cpx2": "^9.0.3",
    "pm2": "^7.0.4",
    "rimraf": "6.1.3",
    "tsc-alias": "1.9.5",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
