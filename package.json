{
  "name": "Schrödinger's app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "rimraf build dist",

    "build": "npm run compile && npm run bundle",

    "compile": "rimraf build && npm run compile-domains && npm run compile-apps",
    "compile-domains": "npm run compile-domain --workspaces --if-present",
    "compile-apps": "npm run compile-app --workspaces --if-present",

    "bundle": "rimraf dist && jitar build && npm run copy",
    "copy": "npm run copy-apps && npm run copy-assets",
    "copy-apps": "cpx 'build/*/app/**/*' 'dist'",
    "copy-assets": "cpx 'build/*/assets/**/*' 'dist'",

    "dev": "jitar start --service=services/development/worker.json",
    "prod": "wireit",

    "gateway": "jitar start --service=services/production/gateway.json",
    "domain": "jitar start --service=services/production/domain.json",
    "terrace-persistence": "jitar start --service=services/production/terrace-persistence.json",
    "terrace-app": "jitar start --service=services/production/terrace-app.json",
    "terrace-proxy": "jitar start --service=services/production/terrace-proxy.json",
    "bar-persistence": "jitar start --service=services/production/bar-persistence.json",
    "bar-app": "jitar start --service=services/production/bar-app.json",
    "bar-proxy": "jitar start --service=services/production/bar-proxy.json"
  },
  "wireit": {
    "prod": {
      "dependencies": ["5:terrace-proxy", "8:bar-proxy"]
    },
    "1:gateway": { "command": "npm run gateway", "service": true },
    "2:domain": { "command": "npm run domain", "service": true, "dependencies": ["1:gateway"] },
    "3:terrace-persistence": { "command": "npm run terrace-persistence", "service": true, "dependencies": ["1:gateway"] },
    "4:terrace-app": { "command": "npm run terrace-app", "service": true },
    "5:terrace-proxy": { "command": "npm run terrace-proxy", "service": true, "dependencies": ["1:gateway", "2:domain", "3:terrace-persistence", "4:terrace-app"] },
    "6:bar-persistence": { "command": "npm run bar-persistence", "service": true, "dependencies": ["1:gateway"] },
    "7:bar-app": { "command": "npm run bar-app", "service": true },
    "8:bar-proxy": { "command": "npm run bar-proxy", "service": true, "dependencies": ["1:gateway", "2:domain", "6:bar-persistence", "7:bar-app"] }
  },
  "workspaces": [
    "src/common",
    "src/terrace",
    "src/bar"
  ],
  "dependencies": {
    "jitar": "0.11.3",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@jitar/plugin-vite": "0.11.3",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "cpx2": "9.0.3",
    "rimraf": "6.1.3",
    "tsc-alias": "1.9.5",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "wireit": "^0.14.13"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
