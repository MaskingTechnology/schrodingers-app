{
  "name": "Schrödinger's app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "rimraf build dist",

    "build": "npm run clean && npm run build-domain && npm run build-app",
    "build-app": "vite build --config src/app/vite.config.js",
    "build-domain": "tsc -p src/tsconfig.json && tsc-alias -p src/tsconfig.json",

    "dist": "rimraf dist && jitar build && npm run copy",
    "clean-dist": "rimraf dist",
    "copy": "npm run copy-apps && npm run copy-assets",
    "copy-apps": "cpx 'build/*/app/**/*' 'dist'",
    "copy-assets": "cpx 'build/*/assets/**/*' 'dist'",
    
    "dev-app": "vite --config src/app/vite.config.js",
    "dev-domain": "jitar start --service=services/worker.json"
  },
  "dependencies": {
    "jitar": "0.11.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@jitar/plugin-vite": "0.11.2",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "cpx2": "9.0.0",
    "rimraf": "6.1.3",
    "tsc-alias": "1.8.17",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
